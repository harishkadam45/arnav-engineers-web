---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { breadcrumbSchema, localBusinessSchema } from '../data/schemas';

const description = `Contact Arnav Engineers - call ${SITE.phoneDisplay} or email ${SITE.email} for quotes on precision machined components, welding fixtures, inspection fixtures and prototype parts. Workshop at Rajmata Industrial Estate, MIDC Bhosari, Pune 411026.`;

const contactCards = [
  {
    icon: 'phone',
    label: 'Call us',
    value: SITE.phoneDisplay,
    sub: SITE.proprietor,
    href: `tel:${SITE.phone}`,
  },
  {
    icon: 'mail',
    label: 'Email us',
    value: SITE.email,
    sub: 'Send drawings in PDF / DWG / image',
    href: `mailto:${SITE.email}`,
  },
] as const;

const mapSrc =
  'https://www.google.com/maps?q=' +
  encodeURIComponent(
    'Rajmata Industrial Estate, Gala No. 42, Plot No. T-58, MIDC Bhosari, Pune 411026, Maharashtra, India',
  ) +
  '&output=embed';
---

<BaseLayout
  title="Contact Us"
  description={description}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      name: `Contact ${SITE.name}`,
      url: new URL(Astro.url.pathname, SITE.url).href,
      description,
      about: { '@id': SITE.url },
    },
    breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Contact' }]),
    localBusinessSchema,
  ]}
>
  <PageHero
    eyebrow="Contact us"
    title="Request a quote or ask a question"
    description="Share your drawing, sample or requirement - we reply quickly with feasibility, pricing and a committed delivery date."
    breadcrumbs={[{ label: 'Contact' }]}
  />

  <section class="py-16 lg:py-24">
    <div class="container-site grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
      <!-- Info column -->
      <div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          {
            contactCards.map((card) => (
              <a
                href={card.href}
                class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-card transition-all hover:-translate-y-1 hover:border-navy-200 hover:shadow-card-lg"
              >
                <span class="grid size-11 place-items-center rounded-xl bg-navy-50 text-navy-700 transition-colors group-hover:bg-flame-500 group-hover:text-navy-950">
                  <Icon name={card.icon} className="size-5" />
                </span>
                <p class="mt-4 text-xs font-semibold tracking-wider text-slate-400 uppercase">{card.label}</p>
                <p class="mt-1 text-sm font-bold break-all text-navy-950">{card.value}</p>
                <p class="mt-1 text-xs text-slate-500">{card.sub}</p>
              </a>
            ))
          }
        </div>

        <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-card sm:p-7">
          <span class="grid size-11 place-items-center rounded-xl bg-navy-50 text-navy-700">
            <Icon name="map-pin" className="size-5" />
          </span>
          <address class="mt-4 text-sm leading-relaxed text-slate-600 not-italic">
            <strong class="font-semibold text-navy-950">Workshop address</strong><br />
            {SITE.address.line1},<br />
            {SITE.address.line2} - {SITE.address.postalCode},<br />
            {SITE.address.state}, {SITE.address.country}
          </address>
          <dl class="mt-5 space-y-2 border-t border-slate-100 pt-5 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-slate-500">GSTIN</dt>
              <dd class="text-right font-medium text-navy-950">{SITE.gst}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-slate-500">Proprietor</dt>
              <dd class="text-right font-medium text-navy-950">{SITE.proprietor}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-slate-500">Working hours</dt>
              <dd class="text-right font-medium text-navy-950">
                {SITE.hours.weekdays}, {SITE.hours.open} - {SITE.hours.close}
              </dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-slate-500">Weekly off</dt>
              <dd class="text-right font-medium text-navy-950">{SITE.hours.weeklyOff}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-slate-500">Service area</dt>
              <dd class="text-right font-medium text-navy-950">Pune & PCMC industrial belt</dd>
            </div>
          </dl>
        </div>

        <!-- Map -->
        <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 shadow-card">
          <iframe
            src={mapSrc}
            title={`Map showing location of ${SITE.name} in MIDC Bhosari, Pune`}
            width="100%"
            height="280"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>

      <!-- Form column -->
      <div class="rounded-[2rem] bg-navy-950 p-8 sm:p-10">
        <h2 class="text-2xl text-white sm:text-3xl">Send an enquiry</h2>
        <p class="mt-3 text-sm leading-relaxed text-navy-200">
          Fill in the details below and press Submit - your enquiry goes straight to our inbox and
          we'll get back to you within one working day. For drawings, WhatsApp a photo or attach
          them when we reply.
        </p>

        <form
          id="enquiry-form"
          name="enquiry"
          method="POST"
          action="/"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="mt-8 grid gap-5"
          novalidate
        >
          <input type="hidden" name="form-name" value="enquiry" />
          <input type="hidden" name="loaded-at" />
          <!-- Honeypot field for spam bots - humans never see or fill it -->
          <p class="hidden" aria-hidden="true">
            <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="f-name" class="mb-1.5 block text-sm font-semibold text-navy-100">
                Your name <span class="text-flame-500">*</span>
              </label>
              <input
                id="f-name"
                name="name"
                type="text"
                required
                maxlength="60"
                autocomplete="name"
                placeholder="Full name"
                aria-describedby="err-name"
                class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-navy-300 focus:border-flame-500 focus:bg-white/10 focus:outline-none"
              />
              <p id="err-name" data-error="name" hidden class="mt-1.5 flex items-start gap-1.5 text-xs font-medium text-red-300">
                <Icon name="circle-alert" className="mt-px size-3.5 shrink-0" />
                <span></span>
              </p>
            </div>
            <div>
              <label for="f-phone" class="mb-1.5 block text-sm font-semibold text-navy-100">
                Phone / WhatsApp
              </label>
              <input
                id="f-phone"
                name="phone"
                type="tel"
                maxlength="16"
                autocomplete="tel"
                placeholder="+91 98765 43210"
                aria-describedby="err-phone"
                class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-navy-300 focus:border-flame-500 focus:bg-white/10 focus:outline-none"
              />
              <p id="err-phone" data-error="phone" hidden class="mt-1.5 flex items-start gap-1.5 text-xs font-medium text-red-300">
                <Icon name="circle-alert" className="mt-px size-3.5 shrink-0" />
                <span></span>
              </p>
            </div>
          </div>
          <div>
            <label for="f-company" class="mb-1.5 block text-sm font-semibold text-navy-100">
              Company name
            </label>
            <input
              id="f-company"
              name="company"
              type="text"
              maxlength="80"
              autocomplete="organization"
              placeholder="Company Pvt. Ltd."
              aria-describedby="err-company"
              class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-navy-300 focus:border-flame-500 focus:bg-white/10 focus:outline-none"
            />
            <p id="err-company" data-error="company" hidden class="mt-1.5 flex items-start gap-1.5 text-xs font-medium text-red-300">
              <Icon name="circle-alert" className="mt-px size-3.5 shrink-0" />
              <span></span>
            </p>
          </div>
          <div>
            <label for="f-message" class="mb-1.5 block text-sm font-semibold text-navy-100">
              What do you need? <span class="text-flame-500">*</span>
            </label>
            <textarea
              id="f-message"
              name="message"
              rows="5"
              required
              maxlength="2000"
              placeholder="e.g. Need 50 brass bushings machined per drawing."
              aria-describedby="err-message"
              class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-navy-300 focus:border-flame-500 focus:bg-white/10 focus:outline-none"></textarea>
            <p id="err-message" data-error="message" hidden class="mt-1.5 flex items-start gap-1.5 text-xs font-medium text-red-300">
              <Icon name="circle-alert" className="mt-px size-3.5 shrink-0" />
              <span></span>
            </p>
          </div>
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-flame-500 px-8 py-4 text-sm font-semibold text-navy-950 transition-all hover:-translate-y-0.5 hover:bg-flame-400"
          >
            Submit
          </button>
          <p id="form-status" class="hidden rounded-xl bg-flame-500/10 px-4 py-3 text-sm text-flame-300" role="status" aria-live="polite"></p>
          <p class="text-xs leading-relaxed text-navy-300">
            Prefer talking? Call us directly at
            <a href={`tel:${SITE.phone}`} class="font-semibold text-flame-400 hover:underline">
              {SITE.phoneDisplay}
            </a>. We work {SITE.hours.weekdays}, {SITE.hours.open} - {SITE.hours.close} (closed on {SITE.hours.weeklyOff}s).
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- Success popup -->
  <dialog
    id="success-dialog"
    aria-labelledby="success-title"
    role="dialog"
    aria-modal="true"
    class="w-[calc(100%-2rem)] max-w-md rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-card-lg sm:p-10"
  >
    <span class="mx-auto grid size-16 place-items-center rounded-full bg-flame-500/15 text-flame-600">
      <Icon name="circle-check-big" className="size-8" />
    </span>
    <h3 id="success-title" class="mt-5 text-2xl">Enquiry submitted!</h3>
    <p class="mt-3 text-sm leading-relaxed text-slate-600">
      Thank you - your information has been submitted successfully. Our team will review it and get
      back to you within one working day.
    </p>
    <button
      id="dialog-close"
      type="button"
      class="mt-7 rounded-full bg-navy-950 px-8 py-3 text-sm font-semibold text-white transition-colors hover:bg-navy-800"
    >
      Done
    </button>
  </dialog>
</BaseLayout>

<script is:inline>
  (() => {
    const form = document.getElementById('enquiry-form');
    const status = document.getElementById('form-status');
    const dialog = document.getElementById('success-dialog');
    const dialogClose = document.getElementById('dialog-close');
    if (!form || !status) return;

    // Delivery strategy: on Netlify hosting we use Netlify Forms; everywhere else
    // (Vercel, localhost, preview servers) submissions go through FormSubmit's AJAX endpoint.
    // NOTE: FormSubmit requires a ONE-TIME activation - the owner must click the
    // "Activate Form" link in the email sitting in dattatrayshinde435@gmail.com.
    const IS_NETLIFY =
      /(^|\.)netlify\.app$/i.test(location.hostname) ||
      ['arnavengineers.com', 'www.arnavengineers.com'].includes(location.hostname);
    const FORMSUBMIT_ENDPOINT = 'https://formsubmit.co/ajax/dattatrayshinde435@gmail.com';

    async function deliver(data) {
      if (IS_NETLIFY) {
        const payload = new URLSearchParams();
        Object.entries(data).forEach(([key, value]) => {
          if (key === 'loaded-at') return;
          if (typeof value === 'string' && value.trim()) payload.append(key, value.trim());
        });
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: payload.toString(),
        });
        if (!res.ok) throw new Error('Netlify submission failed');
        return;
      }
      const res = await fetch(FORMSUBMIT_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          name: data.name.trim(),
          phone: data.phone?.trim() || '-',
          company: data.company?.trim() || '-',
          requirement: data.message.trim(),
          _subject: `Website Enquiry - ${data.name.trim()}`,
          _template: 'table',
          _captcha: 'false',
        }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !(json.success === 'true' || json.success === true)) {
        throw new Error(json.message || 'FormSubmit failed');
      }
    }

    // Netlify Forms handles delivery - submissions land in the Netlify dashboard
    // (Forms tab) and are forwarded to the inbox configured in Form notifications.

    const VALIDATORS = {
      name: (v) => {
        const t = v.trim();
        if (!t) return 'Please enter your name - it is required.';
        if (t.length < 2) return 'Name looks too short - please enter at least 2 characters.';
        if (!/^[A-Za-z][A-Za-z\s.'-]*$/.test(t))
          return 'Name can contain letters, spaces, dots, apostrophes and hyphens only.';
        return '';
      },
      phone: (v) => {
        const t = v.trim();
        if (!t) return ''; // optional field
        if (/[A-Za-z]/.test(t)) return 'Phone number cannot contain letters.';
        if (/[^+\d\s().-]/.test(t)) return 'Phone can contain digits, + and spaces only.';
        const digits = t.replace(/\D/g, '');
        // Accept Indian mobiles: 9876543210, 0 98765 43210, +91 98765 43210
        const national = digits.replace(/^(91|0)/, '');
        if (!/^[6-9]\d{9}$/.test(national))
          return 'Enter a valid 10-digit mobile starting with 6-9, e.g. +91 98765 43210.';
        return '';
      },
      company: (v) => {
        const t = v.trim();
        if (!t) return ''; // optional field
        if (t.length < 2) return 'Company name looks too short.';
        if (t.length > 80) return 'Please keep the company name under 80 characters.';
        return '';
      },
      message: (v) => {
        const t = v.trim();
        if (!t) return 'Please describe what you need - this field is required.';
        if (t.length < 10)
          return 'Please write at least 10 characters so we can understand your requirement.';
        if (t.length > 2000) return 'Message is too long - please keep it under 2000 characters.';
        if (((t.match(/https?:\/\/|www\./gi) || []).length) >= 3)
          return 'Your message contains too many links and looks like spam. Please describe your requirement instead.';
        return '';
      },
    };

    const ERR_BORDER = 'border-red-500';
    const BASE_BORDER = 'border-white/15';
    const FOCUS_OK = 'focus:border-flame-500';
    const FOCUS_ERR = 'focus:border-red-500';

    const fields = Object.keys(VALIDATORS).map((name) => ({
      name,
      input: form.querySelector(`[name="${name}"]`),
      errorEl: form.querySelector(`[data-error="${name}"]`),
    }));

    function validateField(field) {
      const msg = VALIDATORS[field.name](field.input.value);
      if (msg) {
        field.input.setAttribute('aria-invalid', 'true');
        field.input.classList.remove(BASE_BORDER, FOCUS_OK);
        field.input.classList.add(ERR_BORDER, FOCUS_ERR);
        field.errorEl.querySelector('span').textContent = msg;
        field.errorEl.hidden = false;
      } else {
        field.input.setAttribute('aria-invalid', 'false');
        field.input.classList.add(BASE_BORDER, FOCUS_OK);
        field.input.classList.remove(ERR_BORDER, FOCUS_ERR);
        field.errorEl.hidden = true;
      }
      return !msg;
    }

    fields.forEach((field) => {
      if (!field.input || !field.errorEl) return;
      field.input.addEventListener('blur', () => {
        // Only show errors on blur once the user has typed something or tried to submit
        if (field.input.value.trim() !== '' || field.input.getAttribute('aria-invalid') === 'true') {
          validateField(field);
        }
      });
      field.input.addEventListener('input', () => {
        if (field.input.getAttribute('aria-invalid') === 'true') validateField(field);
      });
    });

    // Time-trap: record when the form became interactive; humans take >4s to fill it.
    const tsInput = form.querySelector('[name="loaded-at"]');
    tsInput.value = String(Date.now());

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.classList.add('hidden');

      let firstInvalid = null;
      fields.forEach((field) => {
        const ok = validateField(field);
        if (!ok && !firstInvalid) firstInvalid = field.input;
      });

      if (firstInvalid) {
        status.textContent = 'Please fix the highlighted fields and try again.';
        status.classList.remove('hidden');
        firstInvalid.focus();
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries());

      // Anti-spam time-trap: if submitted faster than a human could type,
      // silently pretend success without delivering anything.
      if (Date.now() - parseInt(data['loaded-at'] || '0', 10) < 4000) {
        form.reset();
        tsInput.value = String(Date.now());
        if (dialog) {
          dialog.showModal();
        } else {
          status.textContent = 'Thank you! Your information has been submitted successfully.';
          status.classList.remove('hidden');
        }
        return;
      }

      // Honeypot tripped: bots that fill the invisible bot-field get the same silent treatment.
      if ((data['bot-field'] || '').trim() !== '') {
        form.reset();
        tsInput.value = String(Date.now());
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]');
      const originalLabel = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting…';

      try {
        await deliver(data);
        form.reset();
        fields.forEach((field) => field.input.setAttribute('aria-invalid', 'false'));
        if (dialog) {
          dialog.showModal();
          if (dialogClose) dialogClose.focus();
        } else {
          status.textContent = 'Thank you! Your information has been submitted successfully.';
          status.classList.remove('hidden');
        }
      } catch {
        status.textContent =
          'Something went wrong while sending your enquiry. Please call us directly at +91 89567 73435 or email dattatrayshinde435@gmail.com - we will respond quickly.';
        status.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });

    if (dialog && dialogClose) {
      dialogClose.addEventListener('click', () => {
        dialog.close();
        submitBtn?.focus();
      });
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) {
          dialog.close();
          submitBtn?.focus();
        }
      });
      });
    }
  })();
</script>
