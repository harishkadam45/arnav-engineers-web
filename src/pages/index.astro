---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { localBusinessSchema } from '../data/schemas';
import { PRODUCTS } from '../data/products';

import heroMachine from '../assets/machines/m1tr-mill.jpg';
import machineMilling from '../assets/machines/universal-milling.jpg';
import machineLathe from '../assets/machines/lathe.jpg';

const services = [
  {
    icon: 'settings',
    title: 'Precision Machining',
    text: 'Milling & turning of close-tolerance components on M1TR, universal milling and heavy-duty lathe machines.',
  },
  {
    icon: 'wrench',
    title: 'Welding Fixtures',
    text: 'Design, manufacture & supply of welding fixtures that hold every weldment accurately, repeatably.',
  },
  {
    icon: 'ruler',
    title: 'Inspection Fixtures',
    text: 'Inspection fixtures & gauges built and verified with calibrated MITUTOYO measuring instruments.',
  },
  {
    icon: 'box',
    title: 'Prototype Parts',
    text: 'Fast development of prototype parts to validate your designs before committing to production.',
  },
  {
    icon: 'pencil-ruler',
    title: 'Tool Room Job Work',
    text: 'Complete tool room job work — from drawings and one-off jobs to repeat batches.',
  },
  {
    icon: 'flame',
    title: 'Arc / MIG / TIG Welding',
    text: 'Fabrication & welding up to 400 AMP across arc, MIG and TIG processes by certified welders.',
  },
] as const;

const promises = [
  {
    icon: 'shield-check',
    title: 'Quality Excellence',
    text: 'Consistent, reliable, high-quality products — checked on calibrated instruments before dispatch.',
  },
  {
    icon: 'truck',
    title: 'On-Time Delivery',
    text: 'Meeting deadlines without compromise. Your production schedule is our schedule.',
  },
  {
    icon: 'coins',
    title: 'Cost Efficiency',
    text: 'Optimised processes and right-first-time manufacturing keep your component costs competitive.',
  },
] as const;
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  schema={[localBusinessSchema]}
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-navy-950">
    <div class="absolute inset-0 bg-blueprint" aria-hidden="true"></div>
    <div
      class="absolute -top-40 -right-40 size-[560px] rounded-full bg-navy-600/30 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute -bottom-48 -left-32 size-[480px] rounded-full bg-flame-500/10 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="container-site relative grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-2 lg:gap-16 lg:py-28">
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-medium tracking-wide text-navy-100"
        >
          <span class="size-1.5 rounded-full bg-flame-500" aria-hidden="true"></span>
          Tool room & job-work specialists — MIDC Bhosari, Pune
        </p>

        <h1 class="mt-6 text-4xl leading-[1.08] font-bold text-white sm:text-5xl lg:text-[3.6rem]">
          Precision machined components &
          <span class="relative whitespace-nowrap text-flame-500">fixtures</span>, built right the
          first time.
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-navy-200">
          {SITE.name} manufactures & supplies precision machined components and tool room job works,
          plus design & build of welding fixtures, inspection fixtures and prototype parts.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/contact/"
            class="group inline-flex items-center gap-2 rounded-full bg-flame-500 px-7 py-3.5 text-sm font-semibold text-navy-950 shadow-lg shadow-flame-500/25 transition-all hover:-translate-y-0.5 hover:bg-flame-400"
          >
            Request a Quote
            <Icon name="arrow-right" className="size-4 transition-transform group-hover:translate-x-0.5" />
          </a>
          <a
            href="/capabilities/"
            class="inline-flex items-center gap-2 rounded-full border border-white/25 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:border-flame-500 hover:text-flame-400"
          >
            Explore Capabilities
          </a>
        </div>

        <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-navy-200">
          {
            ['MITUTOYO-inspected quality', 'On-time delivery', 'GST registered'].map((item) => (
              <li class="flex items-center gap-2">
                <Icon name="circle-check-big" className="size-4.5 text-flame-500" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Hero visual -->
      <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
        <div
          class="absolute -inset-3 rounded-[2rem] bg-gradient-to-tr from-flame-500/60 via-navy-500/20 to-transparent opacity-70 blur-xl"
          aria-hidden="true"
        >
        </div>
        <figure
          class="relative overflow-hidden rounded-[1.75rem] border border-white/15 shadow-2xl shadow-navy-950"
        >
          <Image
            src={heroMachine}
            alt="M1TR milling machine with digital read-out at Arnav Engineers workshop"
            widths={[400, 640, 880]}
            sizes="(min-width: 1024px) 44vw, 92vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="sr-only">M1TR (TRM 3V) milling machine with DRO</figcaption>
        </figure>

        <!-- floating stat card -->
        <dl
          class="absolute -bottom-6 left-4 flex items-center gap-4 rounded-2xl bg-white p-4 pr-6 shadow-xl sm:left-8"
        >
          <span class="grid size-11 place-items-center rounded-xl bg-navy-50 text-navy-700">
            <Icon name="badge-check" className="size-6" />
          </span>
          <div>
            <dt class="text-xs text-slate-500">Measured on</dt>
            <dd class="text-sm font-bold text-navy-950">Calibrated MITUTOYO instruments</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Promise strip -->
    <div class="relative border-t border-white/10 bg-navy-900/60 backdrop-blur">
      <div class="container-site grid gap-8 py-10 sm:grid-cols-3">
        {
          promises.map((p) => (
            <div class="flex items-start gap-4">
              <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-flame-500/15 text-flame-500">
                <Icon name={p.icon} className="size-6" />
              </span>
              <div>
                <h3 class="text-base font-bold text-white">{p.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-navy-200">{p.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="bg-slate-50 py-20 lg:py-28" aria-labelledby="services-heading">
    <div class="container-site">
      <SectionHeading
        id="services-heading"
        eyebrow="What we do"
        title="Manufacturing capabilities end-to-end"
        description="From raw stock to inspected, ready-to-fit parts — everything handled in-house at our MIDC Bhosari workshop."
      />

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s) => (
            <article class="group relative rounded-2xl border border-slate-200 bg-white p-7 shadow-card transition-all duration-300 hover:-translate-y-1.5 hover:border-navy-200 hover:shadow-card-lg">
              <span class="grid size-13 place-items-center rounded-xl bg-navy-50 text-navy-700 transition-colors group-hover:bg-flame-500 group-hover:text-navy-950">
                <Icon name={s.icon} className="size-6.5" />
              </span>
              <h3 class="mt-5 text-lg">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ FACILITIES TEASER ============ -->
  <section class="py-20 lg:py-28" aria-labelledby="facilities-heading">
    <div class="container-site">
      <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
        <div>
          <SectionHeading
            id="facilities-heading"
            eyebrow="Our facilities"
            title="A well-equipped tool room under one roof"
            description="Machining, fabrication, welding and inspection — all in-house, so quality and lead times stay in our control."
            align="left"
          />
          <ul class="mt-8 space-y-4">
            {
              [
                'M1TR machine (TRM 3V) with DRO — 1200 × 400 × 350 mm',
                'Universal milling machine, Vernier German make — 1000 × 400 × 300 mm',
                'Heavy-duty lathe, 5.5 feet',
                'Arc (400 A), MIG (350 A) & TIG (400 A) welding sets',
              ].map((item) => (
                <li class="flex items-start gap-3 text-slate-700">
                  <Icon name="circle-check-big" className="mt-0.5 size-5 shrink-0 text-flame-600" />
                  {item}
                </li>
              ))
            }
          </ul>
          <a
            href="/capabilities/"
            class="group mt-9 inline-flex items-center gap-2 text-sm font-semibold text-navy-800 transition-colors hover:text-flame-600"
          >
            See full facilities list
            <Icon
              name="arrow-right"
              className="size-4 transition-transform group-hover:translate-x-1"
            />
          </a>
        </div>

        <div class="grid grid-cols-2 gap-5">
          <Image
            src={heroMachine}
            alt="M1TR machine used for precision milling at Arnav Engineers"
            widths={[300, 520]}
            sizes="(min-width: 1024px) 24vw, 45vw"
            loading="lazy"
            class="col-span-1 aspect-square h-full w-full rounded-2xl object-cover shadow-card"
          />
          <Image
            src={machineMilling}
            alt="Universal milling machine, Vernier German make, at Arnav Engineers"
            widths={[300, 520]}
            sizes="(min-width: 1024px) 24vw, 45vw"
            loading="lazy"
            class="col-span-1 mt-8 aspect-square h-full w-full rounded-2xl object-cover shadow-card"
          />
          <Image
            src={machineLathe}
            alt="Heavy-duty 5.5 feet lathe machine at Arnav Engineers"
            widths={[300, 520]}
            sizes="(min-width: 1024px) 24vw, 45vw"
            loading="lazy"
            class="col-span-1 -mt-4 aspect-square h-full w-full rounded-2xl object-cover shadow-card"
          />
          <Image
            src={PRODUCTS[4].image}
            alt={PRODUCTS[4].alt}
            widths={[300, 520]}
            sizes="(min-width: 1024px) 24vw, 45vw"
            loading="lazy"
            class="col-span-1 mt-4 aspect-square h-full w-full rounded-2xl object-cover shadow-card"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PRODUCTS TEASER ============ -->
  <section class="bg-navy-950 py-20 lg:py-28" aria-labelledby="products-teaser-heading">
    <div class="container-site">
      <SectionHeading
        id="products-teaser-heading"
        eyebrow="Products"
        title="Components we manufacture & supply"
        description="A snapshot of parts regularly produced for automation, automotive and general engineering customers."
        dark
      />

      <div class="mt-14 grid grid-cols-2 gap-5 md:grid-cols-3">
        {
          [PRODUCTS[0], PRODUCTS[2], PRODUCTS[4], PRODUCTS[7], PRODUCTS[8], PRODUCTS[9]].map(
            (p) => (
              <figure class="group relative overflow-hidden rounded-2xl ring-1 ring-white/10">
                <Image
                  src={p.image}
                  alt={p.alt}
                  widths={[280, 420, 560]}
                  sizes="(min-width: 768px) 30vw, 46vw"
                  loading="lazy"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy-950/95 via-navy-950/50 to-transparent p-4 pt-10 text-sm font-semibold text-white">
                  {p.name}
                  <span class="block text-xs font-normal text-navy-200">{p.category}</span>
                </figcaption>
              </figure>
            ),
          )
        }
      </div>

      <div class="mt-12 text-center">
        <a
          href="/products/"
          class="group inline-flex items-center gap-2 rounded-full bg-flame-500 px-7 py-3.5 text-sm font-semibold text-navy-950 transition-all hover:-translate-y-0.5 hover:bg-flame-400"
        >
          View full product gallery
          <Icon name="arrow-right" className="size-4 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- ============ CLIENTS ============ -->
  <section class="border-b border-slate-100 py-14" aria-label="Our valuable customers">
    <div class="container-site">
      <p class="text-center text-xs font-semibold tracking-[0.22em] text-slate-500 uppercase">
        Trusted by teams across Pune's manufacturing belt
      </p>
      <ul
        class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-4 text-center"
      >
        {
          [
            'Delight Process Designers & Automation',
            'Kudale Automation',
            'Cork Automation',
            '3D Cad India Pvt. Ltd.',
            'Kirpekar Engineering Pvt. Ltd.',
          ].map((name) => (
            <li class="font-display text-base font-bold text-navy-900/70 transition-colors hover:text-navy-950 sm:text-lg">
              {name}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="py-20 lg:py-24">
    <div class="container-site">
      <div
        class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-navy-800 via-navy-900 to-navy-950 px-8 py-14 text-center sm:px-14"
      >
        <div class="absolute inset-0 bg-blueprint opacity-60" aria-hidden="true"></div>
        <div
          class="absolute -right-20 -bottom-24 size-72 rounded-full bg-flame-500/15 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div class="relative">
          <h2 class="mx-auto max-w-2xl text-3xl text-white sm:text-4xl">
            Have a drawing? Get a quote within one working day.
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-navy-200">
            Send us your drawing or sample — we'll respond quickly with feasibility, pricing and a
            committed delivery date.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a
              href={`tel:${SITE.phone}`}
              class="rounded-full bg-flame-500 px-7 py-3.5 text-sm font-semibold text-navy-950 transition-all hover:-translate-y-0.5 hover:bg-flame-400"
            >
              Call {SITE.phoneDisplay}
            </a>
            <a
              href="/contact/"
              class="rounded-full border border-white/25 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:border-flame-500 hover:text-flame-400"
            >
              Send an Enquiry
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
