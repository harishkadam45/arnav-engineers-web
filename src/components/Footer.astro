---
import { SITE, NAV_LINKS } from '../data/site';
import Icon from './Icon.astro';

const capabilities = [
  { href: '/capabilities/', label: 'Precision Machining' },
  { href: '/capabilities/', label: 'Welding Fixtures' },
  { href: '/capabilities/', label: 'Inspection Fixtures' },
  { href: '/capabilities/', label: 'Prototype Parts' },
  { href: '/capabilities/', label: 'Tool Room Job Work' },
];

const year = new Date().getFullYear();
---

<footer class="bg-navy-950 text-navy-100">
  <div class="container-site grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
    <!-- Company -->
    <div class="lg:col-span-4">
      <p class="font-display text-2xl font-bold tracking-tight text-white">
        ARNAV<span class="text-flame-500">.</span> ENGINEERS
      </p>
      <p class="mt-3 font-display text-sm font-medium tracking-wide text-flame-400 italic">
        {SITE.tagline}
      </p>
      <p class="mt-4 max-w-sm text-sm leading-6 text-navy-200">
        Manufacturer & supplier of precision machined components and tool room job works. Design,
        manufacture & supply of welding fixtures, inspection fixtures and prototype parts.
      </p>
      <p class="mt-6 text-xs text-navy-300">
        GSTIN: <span class="font-medium text-navy-100">{SITE.gst}</span>
      </p>
    </div>

    <!-- Quick links -->
    <nav class="lg:col-span-2" aria-label="Footer">
      <h3 class="text-sm font-semibold tracking-wider text-white uppercase">Company</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-navy-200 transition-colors hover:text-flame-400">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Capabilities -->
    <div class="lg:col-span-3">
      <h3 class="text-sm font-semibold tracking-wider text-white uppercase">What we do</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          capabilities.map((c) => (
            <li>
              <a href={c.href} class="text-navy-200 transition-colors hover:text-flame-400">
                {c.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Contact -->
    <address class="not-italic lg:col-span-3">
      <h3 class="text-sm font-semibold tracking-wider text-white uppercase">Contact</h3>
      <ul class="mt-4 space-y-3.5 text-sm">
        <li>
          <a
            href={`tel:${SITE.phone}`}
            class="flex items-start gap-2.5 text-navy-200 transition-colors hover:text-flame-400"
          >
            <Icon name="phone" className="mt-0.5 size-4 shrink-0 text-flame-500" />
            <span>{SITE.phoneDisplay}<br /><span class="text-navy-300">{SITE.proprietor}</span></span>
          </a>
        </li>
        <li>
          <a
            href={`mailto:${SITE.email}`}
            class="flex items-start gap-2.5 break-all text-navy-200 transition-colors hover:text-flame-400"
          >
            <Icon name="mail" className="mt-0.5 size-4 shrink-0 text-flame-500" />
            <span>{SITE.email}</span>
          </a>
        </li>
        <li class="flex items-start gap-2.5 text-navy-200">
          <Icon name="map-pin" className="mt-0.5 size-4 shrink-0 text-flame-500" />
          <span>{SITE.address.line1},<br />{SITE.address.line2} — {SITE.address.postalCode}</span>
        </li>
        <li class="flex items-start gap-2.5 text-navy-200">
          <Icon name="clock" className="mt-0.5 size-4 shrink-0 text-flame-500" />
          <span>
            {SITE.hours.weekdays} · {SITE.hours.open} – {SITE.hours.close}
            <span class="block text-xs text-navy-300">Closed on {SITE.hours.weeklyOff}s</span>
          </span>
        </li>
      </ul>
    </address>
  </div>

  <div class="border-t border-white/10">
    <div
      class="container-site flex flex-col items-center justify-between gap-2 py-5 text-xs text-navy-300 sm:flex-row"
    >
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      <p>Precision machined components & fixtures — {SITE.address.line2}, {SITE.address.state}.</p>
    </div>
  </div>
</footer>
