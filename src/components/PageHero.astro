---
import Icon from './Icon.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  breadcrumbs?: Crumb[];
}

const { eyebrow, title, description, breadcrumbs = [] } = Astro.props;
---

<section class="relative overflow-hidden bg-navy-950">
  <div class="absolute inset-0 bg-blueprint" aria-hidden="true"></div>
  <div
    class="absolute -top-32 right-0 size-[420px] translate-x-1/3 rounded-full bg-navy-600/30 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-site relative pt-10 pb-16 sm:pt-14 sm:pb-20">
    {
      breadcrumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex flex-wrap items-center gap-1.5 text-sm text-navy-300">
            <li>
              <a href="/" class="transition-colors hover:text-flame-400">
                Home
              </a>
            </li>
            {breadcrumbs.map((crumb) => (
              <li class="flex items-center gap-1.5">
                <Icon name="chevron-right" className="size-3.5 text-navy-500" />
                {crumb.href ? (
                  <a href={crumb.href} class="transition-colors hover:text-flame-400">
                    {crumb.label}
                  </a>
                ) : (
                  <span class="font-medium text-navy-100" aria-current="page">
                    {crumb.label}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <p class="flex items-center gap-2 text-sm font-semibold tracking-[0.18em] text-flame-400 uppercase">
      <span class="inline-block h-[3px] w-6 rounded-full bg-current" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h1 class="mt-4 max-w-3xl text-4xl text-white sm:text-5xl">{title}</h1>
    {
      description && (
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-navy-200">{description}</p>
      )
    }
  </div>
</section>
