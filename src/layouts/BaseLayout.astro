---
import SEO, { type PageMeta } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props extends PageMeta {}

const { title, description, schema } = Astro.props;
---

<!doctype html>
<html lang="en-IN" dir="ltr">
  <head>
    <SEO {title} {description} {schema} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-flame-500 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-navy-950"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
